  "info": {
    "_postman_id": "e45ec4c8-fcc4-4d92-a3f5-b1f32402cfbe",
    "name": "Balena Cloud Applications API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The balenaCloud REST API is the primary interface to the Balena platform.\nIt exposes OData-style resources for devices, fleets (applications), releases,\nenvironment variables, organizations, and user accounts. Authentication uses a\nbearer token (session token or named API key) supplied in the\n`Authorization: Bearer <token>` header. Backward-compatible paths for v1-v6\nare translated to the newest version.\n\n\nContact Support:\n Name: balenaCloud",
      "type": "text/plain"
    }
  }
